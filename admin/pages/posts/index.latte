{layout '../../layouts/admin-base.latte'}

{block page_title}{_'Posts'}{/block}

{block content}
<div class="page-header">
    <div>
        <h1>{_'Posts'}</h1>
        <p class="subtitle">{_'Blog articles, news, and long-form writing.'}</p>
    </div>
    <a href="/admin/posts/create" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span>{_'New Post'}</span>
    </a>
</div>

<form class="filter-form" method="get">
    <div class="relative flex-1 min-w-60">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute top-1/2 left-2.5 h-4 w-4 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="search" value="{$filters['search'] ?? ''}" placeholder="{_'Search posts…'}" class="!w-full !pl-8">
    </div>
    <select name="status" class="!w-auto">
        <option value="">{_'All statuses'}</option>
        <option value="draft"     {$filters['status']==='draft'     ? 'selected' : ''}>{_'Draft'}</option>
        <option value="review"    {$filters['status']==='review'    ? 'selected' : ''}>{_'In Review'}</option>
        <option value="scheduled" {$filters['status']==='scheduled' ? 'selected' : ''}>{_'Scheduled'}</option>
        <option value="published" {$filters['status']==='published' ? 'selected' : ''}>{_'Published'}</option>
        <option value="trash"     {$filters['status']==='trash'     ? 'selected' : ''}>{_'Trash'}</option>
    </select>
    <button type="submit" class="btn btn-secondary">{_'Filter'}</button>
</form>

{if empty($posts)}
    <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h12l4 4v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M8 12h8"/></svg>
        <h3>{_'No posts found'}</h3>
        <p>{_'Try adjusting the filters above, or create your first post.'}</p>
        <a href="/admin/posts/create" class="btn btn-primary">{_'New Post'}</a>
    </div>
{else}
<table class="data-table">
    <thead>
        <tr>
            <th>{_'Title'}</th>
            <th>{_'Status'}</th>
            <th>{_'Author'}</th>
            <th>{_'Updated'}</th>
            <th class="text-right">{_'Actions'}</th>
        </tr>
    </thead>
    <tbody>
        {foreach $posts as $post}
        {var $dispStatus = $post['display_status'] ?? $post['status']}
        <tr>
            <td>
                <a href="/admin/posts/{$post['id']}/edit" class="font-medium">{$post['title']}</a>
                {if $dispStatus === 'published'}
                    <a href="{post_path($post['slug'])}" target="_blank" rel="noopener" class="preview-link" title="{_'Open public page'}">↗</a>
                {/if}
            </td>
            <td>
                <span class="badge badge-{$dispStatus}">
                    {$dispStatus|translate}
                    {if $dispStatus === 'scheduled' && !empty($post['published_at'])}
                        <span class="text-xs font-normal opacity-80">({$post['published_at']|date:'m/d H:i'})</span>
                    {/if}
                </span>
            </td>
            <td class="text-slate-500">{$post['author_name'] ?? '—'}</td>
            <td class="text-slate-500">{$post['updated_at']|date:'Y/m/d'}</td>
            <td class="actions">
                <a href="/admin/posts/{$post['id']}/edit" class="btn btn-secondary btn-sm">{_'Edit'}</a>
                <form method="post" action="/admin/posts/{$post['id']}/delete" class="inline">
                    <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm({_'Delete this item?'})">{_'Delete'}</button>
                </form>
            </td>
        </tr>
        {/foreach}
    </tbody>
</table>

{if $total > $per_page}
<div class="pagination-wrapper">
    {var $totalPages = (int) ceil($total / $per_page)}
    {for $i = 1; $i <= $totalPages; $i++}
        {if $i === $current_page}
            <span class="pagination-current">{$i}</span>
        {else}
            <a href="?page={$i}&status={$filters['status'] ?? ''}&search={$filters['search'] ?? ''}">{$i}</a>
        {/if}
    {/for}
</div>
{/if}
{/if}
{/block}
