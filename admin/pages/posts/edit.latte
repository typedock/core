{layout '../../layouts/admin-base.latte'}

{var $postType = $post_type ?? ($post['post_type'] ?? 'post')}
{var $noun = $postType === 'page' ? 'Page' : 'Post'}

{block page_title}{if $post['id'] ?? ''}{_'Edit'} {$noun|translate}{else}{_'New'} {$noun|translate}{/if}{/block}

{block head}
<link rel="stylesheet" href="/admin/dist/editor.bundle.css?v={$editor_asset_version}">
{/block}

{block content}
<form method="post" action="{$form_action}" id="post-form">
    <input type="hidden" name="_csrf_token" value="{$csrf_token}">
    <input type="hidden" name="post_type" value="{$postType}">
    {* Hidden textarea: receives serialized Tiptap JSON on submit. Source of truth on POST. *}
    <textarea name="body" id="body-field" hidden>{$post['body'] ?? ''}</textarea>

    {*
        Sticky publish bar — mirrors Ghost's top-of-editor control strip.
        Holds the small-footprint controls that must always be reachable
        (status, publish date, save). Metadata with more surface area
        (Categories/Tags/Excerpt/SEO) lives in collapsible sections below
        so the writing column stays centered and uncluttered.
    *}
    <div class="editor-publishbar">
        <label class="pb-field">
            <span>{_'Status'}</span>
            <select name="status">
                <option value="draft"     {($post['status'] ?? 'draft')==='draft'     ? 'selected' : ''}>{_'Draft'}</option>
                <option value="review"    {($post['status'] ?? '')==='review'         ? 'selected' : ''}>{_'In Review'}</option>
                <option value="published" {($post['status'] ?? '')==='published'      ? 'selected' : ''}>{_'Published'}</option>
            </select>
        </label>

        <label class="pb-field">
            <span>{_'Publish Date'}</span>
            {var $publishedAtRaw = $post['published_at'] ?? ''}
            {* datetime-local expects `YYYY-MM-DDTHH:MM`; DB stores `YYYY-MM-DD HH:MM:SS`. *}
            <input type="datetime-local" name="published_at"
                   value="{$publishedAtRaw ? str_replace(' ', 'T', substr($publishedAtRaw, 0, 16)) : ''}">
        </label>

        {if isset($public_url) && ($post['status'] ?? '') === 'published'}
            <a class="pb-view" href="{$public_url}" target="_blank" rel="noopener"
               title="{_'Open public URL'}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="m10 14 11-11"/></svg>
                <code class="overflow-hidden text-ellipsis">{$public_url}</code>
            </a>
        {/if}

        <div class="pb-actions">
            <button type="submit" class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                <span>{_'Save'}</span>
            </button>
        </div>
    </div>

    <div class="editor-column">
        <input type="text" name="title" id="post-title"
               value="{$post['title'] ?? ''}"
               placeholder="{_'Enter title…'}"
               class="title-input" required>

        <div class="slug-row">
            <label for="post-slug">{_'Slug'}</label>
            <input type="text" name="slug" id="post-slug"
                   value="{$post['slug'] ?? ''}"
                   placeholder="{_'url-slug'}">
        </div>

        <div class="editor-panel-actions" data-editor-panel-actions="draft"></div>

        {* Tiptap editor mount point. The editor bundle reads the hidden
           #body-field above for the initial Tiptap JSON document and writes
           it back on every keystroke. Floating toolbar + slash menu attach
           themselves to document.body. *}
        <div class="editor-shell">
            <div id="editor" class="editor-surface"></div>
        </div>

        {*
            Metadata sections. All collapsible — they stack vertically
            below the body, the natural reading order for "write first,
            then tag". Categories & Tags use <details open> so editors
            find them without hunting; Excerpt & SEO default closed.
        *}
        <details class="meta-section" open>
            <summary>{_'Categories'}</summary>
            <div class="meta-body">
                {if $categories}
                    <div class="grid gap-1.5 sm:grid-cols-2">
                    {foreach $categories as $cat}
                    <label class="checkbox-label">
                        <input type="checkbox" name="category_ids[]" value="{$cat['id']}"
                               {in_array($cat['id'], $selected_categories ?? []) ? 'checked' : ''}>
                        <span>{$cat['name']}</span>
                    </label>
                    {/foreach}
                    </div>
                {else}
                    <p class="meta-hint">{_'No categories yet.'} <a href="/admin/categories" class="text-brand-600 hover:underline">{_'Create one'}</a>.</p>
                {/if}
            </div>
        </details>

        <details class="meta-section" open>
            <summary>{_'Tags'}</summary>
            <div class="meta-body">
                <input type="text" name="tags_input" id="tags-input"
                       value="{implode(', ', $selected_tag_names ?? [])}"
                       placeholder="{_'Enter tags separated by commas…'}">
                <p class="meta-hint">{_'Example:'} PHP, WordPress, CMS</p>
            </div>
        </details>

        <details class="meta-section">
            <summary>{_'Excerpt'}</summary>
            <div class="meta-body">
                <textarea name="excerpt" rows="3">{$post['excerpt'] ?? ''}</textarea>
                <p class="meta-hint">{_'Shown in archives and used as default meta description.'}</p>
            </div>
        </details>

        {if !empty($theme_layouts)}
        <details class="meta-section">
            <summary>{_'Layout'}</summary>
            <div class="meta-body">
                <select name="layout">
                    <option value="">{_'Theme default'}</option>
                    {foreach $theme_layouts as $slug => $info}
                        <option value="{$slug}" {($post['layout'] ?? '') === $slug ? 'selected' : ''}>{$info['label'] ?? $slug}</option>
                    {/foreach}
                </select>
                <p class="meta-hint">{_'Pick an alternative layout declared by the active theme.'}</p>
            </div>
        </details>
        {/if}

        {*
            SEO / OGP section. Core-level replacement for Yoast / AIOSEO.
            Contract with SeoService: empty fields inherit from the global
            defaults set at /admin/settings/seo — we never pre-fill blanks
            with the global values (that would freeze inheritance on first
            save). $seo is the RAW per-target row from
            SeoService::findByTarget(), or an empty array.
        *}
        <details class="meta-section seo-panel" {if !empty($seo)}open{/if}>
            <summary>{_'SEO & Social'}</summary>
            <div class="meta-body space-y-4">
                <div class="editor-panel-actions" data-editor-panel-actions="seo"></div>

                <div class="form-group">
                    <label>{_'SEO Title'} <small>{_'(blank = use title)'}</small></label>
                    <input type="text" name="seo[seo_title]" maxlength="500"
                           value="{$seo['seo_title'] ?? ''}"
                           placeholder="{_'Appears in <title> and search results'}">
                </div>

                <div class="form-group">
                    <label>{_'Meta Description'} <small>{_'(blank = use excerpt)'}</small></label>
                    <textarea name="seo[meta_description]" rows="3"
                              placeholder="{_'Recommended: 120–160 characters'}">{$seo['meta_description'] ?? ''}</textarea>
                </div>

                <div class="form-group">
                    <label>{_'Canonical URL'} <small>{_'(absolute; blank = auto)'}</small></label>
                    <input type="url" name="seo[canonical_url]" maxlength="2000"
                           value="{$seo['canonical_url'] ?? ''}"
                           placeholder="https://example.com/original-source">
                </div>

                <div class="form-group">
                    <label>{_'Robots'}</label>
                    <select name="seo[robots]">
                        {var $robotsVal = $seo['robots'] ?? ''}
                        <option value=""                   {$robotsVal === '' ? 'selected' : ''}>{_'Default (inherit)'}</option>
                        <option value="index,follow"       {$robotsVal === 'index,follow' ? 'selected' : ''}>index, follow</option>
                        <option value="noindex,follow"     {$robotsVal === 'noindex,follow' ? 'selected' : ''}>noindex, follow</option>
                        <option value="index,nofollow"     {$robotsVal === 'index,nofollow' ? 'selected' : ''}>index, nofollow</option>
                        <option value="noindex,nofollow"   {$robotsVal === 'noindex,nofollow' ? 'selected' : ''}>noindex, nofollow</option>
                    </select>
                </div>

                <fieldset class="space-y-3">
                    <legend>{_'Open Graph (Facebook, LinkedIn, etc.)'}</legend>

                    <div class="form-group mb-0">
                        <label>{_'OG Title'} <small>{_'(blank = SEO title)'}</small></label>
                        <input type="text" name="seo[og_title]" maxlength="500"
                               value="{$seo['og_title'] ?? ''}">
                    </div>

                    <div class="form-group mb-0">
                        <label>{_'OG Description'} <small>{_'(blank = meta description)'}</small></label>
                        <textarea name="seo[og_description]" rows="2">{$seo['og_description'] ?? ''}</textarea>
                    </div>

                    <div class="form-group mb-0" id="og-image-field">
                        <label>{_'OG Image'}</label>
                        <div class="og-image-control">
                            <input type="text" name="seo[og_image_id]" id="og-image-id" maxlength="36"
                                   value="{$seo['og_image_id'] ?? ''}"
                                   placeholder="{_'Pick an image from the library'}"
                                   class="font-mono text-xs" readonly>
                            <button type="button" class="btn btn-secondary btn-sm" id="og-image-pick">{_'Choose image'}</button>
                            <button type="button" class="btn btn-ghost btn-sm" id="og-image-clear" {if empty($seo['og_image_id'])}hidden{/if}>{_'Clear'}</button>
                        </div>
                        <div id="og-image-preview" class="og-image-preview" hidden></div>
                        <small class="form-hint">{_'Leave blank to fall back to the site-wide OG image set in'} <a href="/admin/settings/seo" class="text-brand-600 hover:underline">{_'SEO settings'}</a>.</small>
                    </div>
                </fieldset>

                <div class="form-group">
                    <label>{_'Twitter Card'}</label>
                    <select name="seo[twitter_card]">
                        {var $twCard = $seo['twitter_card'] ?? ''}
                        <option value=""                     {$twCard === '' ? 'selected' : ''}>{_'Default (summary_large_image)'}</option>
                        <option value="summary"              {$twCard === 'summary' ? 'selected' : ''}>summary</option>
                        <option value="summary_large_image"  {$twCard === 'summary_large_image' ? 'selected' : ''}>summary_large_image</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>{_'Schema.org Type'} <small>(JSON-LD)</small></label>
                    <select name="seo[schema_type]">
                        {var $schema = $seo['schema_type'] ?? ''}
                        <option value=""              {$schema === '' ? 'selected' : ''}>{_'Auto (post → BlogPosting, page → WebPage)'}</option>
                        <option value="Article"       {$schema === 'Article' ? 'selected' : ''}>Article</option>
                        <option value="BlogPosting"   {$schema === 'BlogPosting' ? 'selected' : ''}>BlogPosting</option>
                        <option value="NewsArticle"   {$schema === 'NewsArticle' ? 'selected' : ''}>NewsArticle</option>
                        <option value="WebPage"       {$schema === 'WebPage' ? 'selected' : ''}>WebPage</option>
                        <option value="FAQPage"       {$schema === 'FAQPage' ? 'selected' : ''}>FAQPage</option>
                        <option value="HowTo"         {$schema === 'HowTo' ? 'selected' : ''}>HowTo</option>
                        <option value="Product"       {$schema === 'Product' ? 'selected' : ''}>Product</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>{_'Focus Keyword'} <small>{_'(for your own reference)'}</small></label>
                    <input type="text" name="seo[focus_keyword]" maxlength="255"
                           value="{$seo['focus_keyword'] ?? ''}">
                </div>
            </div>
        </details>
    </div>
</form>
{/block}

{block scripts}
<script src="/admin/assets/js/media-picker.js"></script>
{var $componentDefsJson = json_encode($component_defs ?? [], \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)}
{var $editorConfigJson = json_encode(['csrfToken' => $csrf_token], \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)}
<script>
  // Component catalog for the editor's slash menu + componentBlock params.
  window.typedockComponentDefs = {$componentDefsJson|noescape};
  window.typedockEditorConfig = {$editorConfigJson|noescape};
</script>
<script src="/admin/dist/editor.bundle.js?v={$editor_asset_version}" defer></script>
{foreach $editor_extension_scripts ?? [] as $scriptSrc}
<script src="{$scriptSrc}" defer></script>
{/foreach}
<script src="/admin/assets/js/seo-og-image.js"></script>
{/block}
