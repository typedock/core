{layout '../../layouts/admin-base.latte'}
{block page_title}Categories{/block}
{block content}
<div class="page-header">
    <h1>Categories</h1>
</div>

<div class="editor-layout" style="grid-template-columns: 1fr 320px;">
    <div>
        <table class="data-table">
            <thead>
                <tr><th>Name</th><th>Slug</th><th>Description</th><th>Posts</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {foreach $categories as $cat}
                <tr>
                    <td>{$cat['name']}</td>
                    <td><code>{$cat['slug']}</code></td>
                    <td>{$cat['description'] ?? ''}</td>
                    <td>{$cat['post_count'] ?? 0}</td>
                    <td>
                        <form method="post" action="/admin/categories/{$cat['id']}/delete" style="display:inline">
                            <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this item?')">Delete</button>
                        </form>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>

    <div>
        <div class="sidebar-panel">
            <h3>Add New Category</h3>
            <form method="post" action="/admin/categories">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" name="name" required>
                </div>
                <div class="form-group">
                    <label>Slug</label>
                    <input type="text" name="slug" placeholder="Auto-generated">
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label>Parent Category</label>
                    <select name="parent_id">
                        <option value="">None</option>
                        {foreach $categories as $cat}
                        <option value="{$cat['id']}">{$cat['name']}</option>
                        {/foreach}
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>
        </div>
    </div>
</div>
{/block}
