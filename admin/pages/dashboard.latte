{layout '../layouts/admin-base.latte'}

{block page_title}Dashboard{/block}

{block content}
<div class="page-header">
    <div>
        <h1>Welcome back, {$current_user['name']}</h1>
        <p class="subtitle">Here's what's happening on {$site->name}.</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="/admin/posts/create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            <span>New Post</span>
        </a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h12l4 4v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M8 8h6"/><path d="M8 12h8"/><path d="M8 16h5"/></svg>
        </div>
        <div>
            <h3>Posts</h3>
            <div class="stat-number">{$stats['posts'] ?? 0}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
        </div>
        <div>
            <h3>Pages</h3>
            <div class="stat-number">{$stats['pages'] ?? 0}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="1.6"/><path d="m21 16-5-5-10 10"/></svg>
        </div>
        <div>
            <h3>Media</h3>
            <div class="stat-number">{$stats['media'] ?? 0}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div>
            <h3>Users</h3>
            <div class="stat-number">{$stats['users'] ?? 0}</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2>Recent Posts</h2>
        <a href="/admin/posts" class="text-sm text-brand-600 hover:text-brand-700 hover:underline">View all</a>
    </div>
    {if empty($recent_posts)}
        <div class="card-body">
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h12l4 4v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M8 12h8"/><path d="M8 16h5"/></svg>
                <h3>No posts yet</h3>
                <p>Start writing — your first post will appear here.</p>
                <a href="/admin/posts/create" class="btn btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                    <span>Create your first post</span>
                </a>
            </div>
        </div>
    {else}
        <table class="data-table border-0 shadow-none rounded-none">
            <thead>
                <tr><th>Title</th><th>Status</th><th>Updated</th><th class="text-right">Actions</th></tr>
            </thead>
            <tbody>
                {foreach $recent_posts as $post}
                <tr>
                    <td><a href="/admin/posts/{$post['id']}/edit" class="font-medium">{$post['title']}</a></td>
                    <td><span class="badge badge-{$post['status']}">{$post['status']}</span></td>
                    <td class="text-slate-500">{$post['updated_at']|date:'Y/m/d'}</td>
                    <td class="actions">
                        <a href="/admin/posts/{$post['id']}/edit" class="btn btn-secondary btn-sm">Edit</a>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    {/if}
</div>
{/block}
