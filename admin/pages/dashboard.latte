{layout '../layouts/admin-base.latte'}

{block page_title}{_'Dashboard'}{/block}

{block content}
<div class="page-header">
    <div>
        <h1>{_'Welcome back, {name}', name: $current_user['name']}</h1>
        <p class="subtitle">{_'Here is what is happening on {site}.', site: $site->name}</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="/admin/posts/create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            <span>{_'New Post'}</span>
        </a>
    </div>
</div>

{if $queue !== null}
<div class="alert alert-warning">
    {include 'icon-alert'}
    <div>
        {if $queue['overdue'] > 0}
            <p><strong>{_'{n} scheduled post(s) are past their publish time.', n: $queue['overdue']}</strong></p>
        {/if}
        {if $queue['failed'] > 0}
            <p><strong>{_'{n} background job(s) failed.', n: $queue['failed']}</strong>
            {if $queue['last_failure'] !== null}
                <code>{$queue['last_failure']['handler']}</code> — {$queue['last_failure']['last_error']}
            {/if}</p>
        {/if}
        <p class="text-sm">
            {if $queue['heartbeat_at'] !== null}
                {_'Background work last ran at {at}.', at: $queue['heartbeat_at']}
            {else}
                {_'Background work has never run on this site.'}
            {/if}
            {_'Without cron, it only runs while an admin has this dashboard open. Add:'}
            <code>* * * * * php {$queue['cli_path']} --max-time=55</code>
        </p>
    </div>
</div>
{/if}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h12l4 4v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M8 8h6"/><path d="M8 12h8"/><path d="M8 16h5"/></svg>
        </div>
        <div>
            <h3>{_'Posts'}</h3>
            <div class="stat-number">{$stats['posts'] ?? 0}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
        </div>
        <div>
            <h3>{_'Pages'}</h3>
            <div class="stat-number">{$stats['pages'] ?? 0}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="1.6"/><path d="m21 16-5-5-10 10"/></svg>
        </div>
        <div>
            <h3>{_'Media'}</h3>
            <div class="stat-number">{$stats['media'] ?? 0}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div>
            <h3>{_'Users'}</h3>
            <div class="stat-number">{$stats['users'] ?? 0}</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2>{_'Recent Posts'}</h2>
        <a href="/admin/posts" class="text-sm text-brand-600 hover:text-brand-700 hover:underline">{_'View all'}</a>
    </div>
    {if empty($recent_posts)}
        <div class="card-body">
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h12l4 4v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M8 12h8"/><path d="M8 16h5"/></svg>
                <h3>{_'No posts yet'}</h3>
                <p>{_'Start writing — your first post will appear here.'}</p>
                <a href="/admin/posts/create" class="btn btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                    <span>{_'Create your first post'}</span>
                </a>
            </div>
        </div>
    {else}
        <table class="data-table border-0 shadow-none rounded-none">
            <thead>
                <tr><th>{_'Title'}</th><th>{_'Status'}</th><th>{_'Updated'}</th><th class="text-right">{_'Actions'}</th></tr>
            </thead>
            <tbody>
                {foreach $recent_posts as $post}
                <tr>
                    <td><a href="/admin/posts/{$post['id']}/edit" class="font-medium">{$post['title']}</a></td>
                    <td><span class="badge badge-{$post['status']}">{$post['status']|translate}</span></td>
                    <td class="text-slate-500">{$post['updated_at']|date:'Y/m/d'}</td>
                    <td class="actions">
                        <a href="/admin/posts/{$post['id']}/edit" class="btn btn-secondary btn-sm">{_'Edit'}</a>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    {/if}
</div>
{/block}
