{layout '../../layouts/admin-base.latte'}

{block page_title}{$media['original_filename']}{/block}

{block content}
<div class="page-header">
    <div>
        <h1 class="truncate" title="{$media['original_filename']}">{$media['original_filename']}</h1>
        <p class="subtitle">
            <span class="badge badge-muted">{$media['mime_type']}</span>
            {if !empty($media['width'])}
                <span class="text-slate-500">{$media['width']} × {$media['height']}</span>
            {/if}
        </p>
    </div>
    <a href="/admin/media" class="btn btn-secondary">← {_'All media'}</a>
</div>

{if !empty($flash_success)}
    <div class="alert alert-success">{$flash_success}</div>
{/if}

<div class="columns-main-sidebar">
    <div>
        <div class="media-detail-preview">
            {if str_starts_with($media['mime_type'], 'image/')}
                <img src="{$media['url']}" alt="{$media['alt_text'] ?? ''}" loading="lazy">
            {else}
                <div class="media-icon-large">{$media['mime_type']}</div>
            {/if}
        </div>

        <form method="post" action="/admin/media/{$media['id']}" class="mt-4">
            <input type="hidden" name="_csrf_token" value="{$csrf_token}">

            <div class="form-group">
                <label for="alt_text">{_'Alt text'}</label>
                <input type="text" id="alt_text" name="alt_text"
                       value="{$media['alt_text'] ?? ''}"
                       placeholder="{_'Describe the image for screen readers and SEO'}">
            </div>

            <div class="form-group">
                <label for="caption">{_'Caption'}</label>
                <textarea id="caption" name="caption" rows="2"
                          placeholder="{_'Optional caption shown under the image'}">{$media['caption'] ?? ''}</textarea>
            </div>

            <button type="submit" class="btn btn-primary">{_'Save'}</button>
        </form>
    </div>

    <aside>
        <div class="sidebar-panel">
            <h3>{_'Details'}</h3>
            <dl class="detail-list">
                <dt>{_'Uploaded'}</dt>
                <dd>{$media['created_at']}</dd>
                <dt>{_'File size'}</dt>
                <dd>{round($media['file_size'] / 1024, 1)} KB</dd>
                <dt>{_'Storage path'}</dt>
                <dd><code class="text-xs break-all">{$media['path']}</code></dd>
                <dt>ID</dt>
                <dd>
                    <code class="text-xs">{$media['id']}</code>
                    <button type="button" class="btn btn-ghost btn-xs copy-url-btn" data-url="{$media['id']}">{_'Copy'}</button>
                </dd>
            </dl>
        </div>

        {if count($variants) > 0}
        <div class="sidebar-panel">
            <h3>{_'Variants'}</h3>
            <p class="text-xs text-slate-500 mb-2">
                {_'Browsers pick the right variant automatically via'} <code>srcset</code>. {_'Copy a URL here only when you need a specific size from another tool.'}
            </p>
            <ul class="variant-list">
                {foreach $variants as $v}
                <li class="variant-row">
                    <div class="variant-meta">
                        <span class="variant-label">{$v['label']}</span>
                        {if $v['is_webp']}<span class="badge badge-muted">WebP</span>{/if}
                        {if $v['max_width']}
                            <span class="text-xs text-slate-500">≤ {$v['max_width']} px</span>
                        {/if}
                    </div>
                    <button type="button" class="btn btn-ghost btn-xs copy-url-btn" data-url="{$v['url']}" title="{$v['url']}">{_'Copy URL'}</button>
                </li>
                {/foreach}
            </ul>
        </div>
        {/if}

        <div class="sidebar-panel">
            <form method="post" action="/admin/media/delete/{$media['id']}">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <button type="submit" class="btn btn-danger btn-block"
                        onclick="return confirm({_'Delete this media item? Thumbnails and WebP siblings are removed too.'})">
                    {_'Delete media'}
                </button>
            </form>
        </div>
    </aside>
</div>

<style>
    .media-detail-preview {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        padding: 1rem;
        text-align: center;
    }
    .media-detail-preview img {
        max-width: 100%;
        max-height: 70vh;
        height: auto;
    }
    .media-icon-large {
        padding: 4rem 1rem;
        color: #64748b;
        font-family: ui-monospace, monospace;
    }
    .detail-list {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.25rem 0.75rem;
        font-size: 0.875rem;
    }
    .detail-list dt { color: #64748b; }
    .detail-list dd { margin: 0; }
    .variant-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .variant-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.375rem 0;
        border-bottom: 1px solid #f1f5f9;
    }
    .variant-row:last-child { border-bottom: none; }
    .variant-meta {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        flex-wrap: wrap;
    }
    .variant-label { font-weight: 500; font-size: 0.875rem; }
</style>
{/block}

{block scripts}
<script>
    document.querySelectorAll('.copy-url-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
            const url = btn.dataset.url;
            if (!url) return;
            try {
                await navigator.clipboard.writeText(url);
                const prev = btn.textContent;
                btn.textContent = {_'Copied!'};
                setTimeout(() => { btn.textContent = prev; }, 1200);
            } catch { /* ignore */ }
        });
    });
</script>
{/block}
