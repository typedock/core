{layout '../../layouts/admin-base.latte'}
{block page_title}Menus{/block}
{block content}
<div class="page-header">
    <h1>Menus</h1>
</div>

<div class="editor-layout" style="grid-template-columns: 1fr 320px;">
    <div>
        <table class="data-table">
            <thead>
                <tr><th>Name</th><th>Location</th><th>Language</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {foreach $menus as $menu}
                <tr>
                    <td><a href="/admin/menus/{$menu['id']}/edit">{$menu['name']}</a></td>
                    <td><code>{$menu['location']}</code></td>
                    <td>{$menu['locale']}</td>
                    <td>
                        <a href="/admin/menus/{$menu['id']}/edit" class="btn btn-sm">Edit</a>
                        <form method="post" action="/admin/menus/{$menu['id']}/delete" style="display:inline">
                            <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this item?')">Delete</button>
                        </form>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>

    <div>
        <div class="sidebar-panel">
            <h3>Create New Menu</h3>
            <form method="post" action="/admin/menus">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <div class="form-group">
                    <label>Menu Name</label>
                    <input type="text" name="name" required placeholder="e.g. Main Menu">
                </div>
                <div class="form-group">
                    <label>Location</label>
                    <input type="text" name="location" required placeholder="e.g. primary">
                    <small>Specify the menu location defined in your theme.</small>
                </div>
                <div class="form-group">
                    <label>Language</label>
                    <input type="text" name="locale" value="en" placeholder="en">
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </form>
        </div>
    </div>
</div>
{/block}
