{layout '../../layouts/admin-base.latte'}

{block page_title}Menus{/block}

{block content}
<div class="page-header">
    <div>
        <h1>Menus</h1>
        <p class="subtitle">Navigation locations declared by the active theme. Pick one to edit its items.</p>
    </div>
</div>

{if empty($locations)}
    <div class="empty-state">
        <h3>No menu locations</h3>
        <p>The active theme does not declare any <code>menus</code> block in its <code>theme.json</code>.</p>
    </div>
{else}
<div class="columns columns-3">
    {foreach $locations as $key => $meta}
    <a href="/admin/menus/{$key}" class="card block hover:shadow-md transition">
        <div class="card-body">
            <h2 class="text-lg font-semibold">{$meta['label'] ?? $key}</h2>
            <p class="text-xs text-slate-500 mt-1"><code>{$key}</code></p>
            {if !empty($meta['description'])}
                <p class="text-sm text-slate-600 mt-3">{$meta['description']}</p>
            {/if}
            <p class="text-xs text-slate-500 mt-3">
                {$counts[$key] ?? 0} item{($counts[$key] ?? 0) === 1 ? '' : 's'}
            </p>
        </div>
    </a>
    {/foreach}
</div>
{/if}
{/block}
