{layout '../../layouts/admin-base.latte'}

{block page_title}Themes{/block}

{block content}
<div class="page-header">
    <div>
        <h1>Themes</h1>
        <p class="subtitle">
            Switch the active front-end theme. Theme files cannot be edited from the admin —
            update them on disk and redeploy, or reinstall the package.
        </p>
    </div>
</div>

{if empty($themes)}
    <div class="empty-state">
        <h3>No themes installed</h3>
        <p>Add a theme under <code>themes/&lt;slug&gt;/</code> and reload this page.</p>
    </div>
{else}
<div class="columns columns-3">
    {foreach $themes as $theme}
    <div class="card theme-card">
        <div class="theme-card-screenshot" aria-hidden="true">
            {if $theme['screenshot']}
                <img src="{$theme['screenshot']}" alt="">
            {else}
                <div class="theme-card-screenshot-placeholder">
                    <span>{substr($theme['name'], 0, 1)|upper}</span>
                </div>
            {/if}
            {if $theme['is_active']}
                <span class="badge badge-success theme-card-badge">Active</span>
            {/if}
        </div>
        <div class="card-body">
            <h2 class="theme-card-title">
                {$theme['name']}
                {if $theme['version']}<span class="text-xs text-slate-500">v{$theme['version']}</span>{/if}
            </h2>
            {if $theme['author']}
                <p class="text-xs text-slate-500">by {$theme['author']}</p>
            {/if}
            {if $theme['description']}
                <p class="theme-card-description">{$theme['description']}</p>
            {/if}
            <p class="text-xs text-slate-500 mt-2">
                <span>{$theme['slot_count']} slot{$theme['slot_count'] === 1 ? '' : 's'}</span>
                <span class="mx-1">·</span>
                <code class="text-[11px]">{$theme['slug']}</code>
            </p>
        </div>
        <div class="card-footer cluster-sm">
            <a href="/admin/themes/preview?theme={$theme['slug']|escapeUrl}" target="_blank" rel="noopener"
               class="btn btn-secondary btn-sm">
                {include 'icon-eye'}<span>Preview</span>
            </a>
            {if $theme['is_active']}
                <a href="/admin/theme-settings" class="btn btn-secondary btn-sm">Settings</a>
                <button type="button" class="btn btn-ghost btn-sm" disabled>Active</button>
            {else}
            <form method="post" action="/admin/themes/activate" class="inline"
                  onsubmit="return confirm('Activating this theme will reset slot placements to its defaults. Continue?');">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <input type="hidden" name="theme" value="{$theme['slug']}">
                <button type="submit" class="btn btn-primary btn-sm">Activate</button>
            </form>
            {/if}
        </div>
    </div>
    {/foreach}
</div>
{/if}

<style>
    .theme-card { display: flex; flex-direction: column; overflow: hidden; }
    .theme-card .card-body { flex: 1; }
    .theme-card-screenshot {
        position: relative; aspect-ratio: 16 / 10; background: #f1f5f9;
        overflow: hidden; border-bottom: 1px solid #e5e7eb;
    }
    .theme-card-screenshot img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .theme-card-screenshot-placeholder {
        width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
        color: #cbd5e1; font-size: 3rem; font-weight: 700;
        background: linear-gradient(135deg, #f8fafc, #e2e8f0);
    }
    .theme-card-badge { position: absolute; top: 0.75rem; right: 0.75rem; }
    .theme-card-title { font-size: 1rem; font-weight: 600; margin: 0 0 0.125rem; display: flex; align-items: baseline; gap: 0.5rem; }
    .theme-card-description { font-size: 0.875rem; color: #475569; margin-top: 0.5rem; line-height: 1.5; }
    .card-footer.cluster-sm { display: flex; gap: 0.5rem; align-items: center; }
</style>
{/block}
