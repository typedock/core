{layout '../../layouts/admin-base.latte'}

{block page_title}{_'Site Settings'}{/block}

{block content}
<div class="page-header">
    <div>
        <h1>{_'Site Settings'}</h1>
        <p class="subtitle">{_'General site configuration.'}</p>
    </div>
</div>

<nav class="tabs">
    <a href="/admin/settings/general" class="is-active">{_'General'}</a>
    <a href="/admin/settings/seo">{_'SEO'}</a>
    <a href="/admin/settings/mail">{_'Mail'}</a>
    <a href="/admin/settings/api">{_'API'}</a>
    <a href="/admin/settings/modules">{_'Modules'}</a>
    <a href="/admin/settings/cache">{_'Cache'}</a>
</nav>

<div class="card max-w-3xl">
    <div class="card-body">
        <form method="post" action="/admin/settings/general">
            <input type="hidden" name="_csrf_token" value="{$csrf_token}">

            <div class="form-group">
                <label for="site_name">{_'Site Name'}</label>
                <input type="text" id="site_name" name="site_name"
                       value="{$options['site.name'] ?? ''}" required>
            </div>

            <div class="form-group">
                <label for="site_description">{_'Site Description'}</label>
                <textarea id="site_description" name="site_description" rows="3">{$options['site.description'] ?? ''}</textarea>
            </div>

            <div class="form-group" id="favicon-field">
                <label>{_'Site Icon / Favicon'}</label>
                <div class="og-image-control">
                    <input type="text" name="favicon_id" id="favicon-id" maxlength="36"
                           value="{$options['site.favicon_id'] ?? ''}"
                           placeholder="{_'Pick an icon from the library'}"
                           class="font-mono text-xs" readonly>
                    <button type="button" class="btn btn-secondary btn-sm" id="favicon-pick">{_'Choose icon'}</button>
                    <button type="button" class="btn btn-ghost btn-sm" id="favicon-clear" {if empty($options['site.favicon_id'])}hidden{/if}>{_'Clear'}</button>
                </div>
                <div id="favicon-preview" class="og-image-preview !w-16 !h-16" {if empty($favicon_preview)}hidden{/if}>
                    {if !empty($favicon_preview)}
                        <img src="{$favicon_preview['url']}" alt="{$favicon_preview['alt_text'] ?? ''}" loading="lazy" class="w-full h-full object-contain">
                    {/if}
                </div>
                <small class="form-hint">{_'Used as the browser favicon and app icon. Recommended square PNG or SVG, at least 512×512 px.'}</small>
            </div>

            <div class="form-group">
                <label>Site Locale</label>
                <div class="cluster-sm">
                    <span class="badge badge-info">{$site_locale['current'] ?? 'en'}</span>
                    <span class="text-xs text-slate-500">
                        Default: <code>{$site_locale['default'] ?? 'en'}</code>
                        · Source: <code>{$site_locale['source'] ?? 'APP_LOCALE'}</code>
                    </span>
                </div>
                <small class="form-hint">Used for public content, menus, taxonomy, and theme rendering. Admin interface language is configured separately.</small>
            </div>

            <fieldset class="form-fieldset">
                <legend>{_'Home page'}</legend>

                <div class="form-group">
                    <label for="home_mode">{_'What to show at'} <code>/</code></label>
                    {var $homeMode = $options['site.home_mode'] ?? 'archive'}
                    <select id="home_mode" name="home_mode">
                        <option value="archive" {$homeMode === 'archive' ? 'selected' : ''}>{_'Latest posts (archive)'}</option>
                        <option value="page" {$homeMode === 'page' ? 'selected' : ''}>{_'A static page'}</option>
                        <option value="source" {$homeMode === 'source' ? 'selected' : ''}>{_'An External Source'}</option>
                    </select>
                    <small class="form-hint">
                        {_'When home mode is set to'} <strong>{_'A static page'}</strong> {_'or'} <strong>{_'An External Source'}</strong> {_'choose the matching item below.'}
                        {_'Themes can still differentiate'} <code>/</code> {_'and'} <code>/{$options['site.posts_archive_slug'] ?? 'blog'}</code> {_'via a'} <code>home.latte</code> {_'template.'}
                    </small>
                </div>

                <div class="form-group">
                    <label for="home_page_id">{_'Home page (when using a static page)'}</label>
                    {var $homePageId = $options['site.home_page_id'] ?? ''}
                    <select id="home_page_id" name="home_page_id">
                        <option value="">{_'— select a page —'}</option>
                        {foreach $pages as $p}
                            <option value="{$p['id']}" {$homePageId === $p['id'] ? 'selected' : ''}>{$p['title']}</option>
                        {/foreach}
                    </select>
                </div>

                <div class="form-group">
                    <label for="home_source_id">{_'Home External Source'}</label>
                    {var $homeSourceId = $options['site.home_source_id'] ?? ''}
                    <select id="home_source_id" name="home_source_id">
                        <option value="">{_'— select a source —'}</option>
                        {foreach $external_sources as $source}
                            <option value="{$source['id']}" {$homeSourceId === $source['id'] ? 'selected' : ''}>{$source['name']} (/{$source['slug']})</option>
                        {/foreach}
                    </select>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>{_'Posts archive'}</legend>

                <div class="form-group">
                    <label for="posts_archive_slug">{_'Posts URL path'}</label>
                    <input type="text" id="posts_archive_slug" name="posts_archive_slug"
                           value="{$options['site.posts_archive_slug'] ?? 'blog'}"
                           placeholder="blog" pattern="[A-Za-z0-9_\-]+">
                    <small class="form-hint">
                        {_'URL segment for the posts archive and single post pages, e.g.'}
                        <code>blog</code> → <code>/blog</code>, <code>/blog/hello-world</code>.
                        {_'Allowed characters: letters, digits,'} <code>-</code>, <code>_</code>.
                        {_'Reserved words'} (<code>admin</code>, <code>api</code>, <code>search</code>,
                        <code>category</code>, <code>tag</code>, <code>page</code>, <code>feed</code>)
                        {_'are rejected silently — the slug falls back to'} <code>blog</code>.
                        <strong>{_'Changing this does not create redirects from the old path.'}</strong>
                        {_'If you already published posts under the old slug,'}
                        {_'add redirects at'} <a href="/admin/redirects" class="text-brand-600 hover:underline">{_'Redirects'}</a>
                        (e.g. <code>/blog/foo</code> → <code>/journal/foo</code>).
                    </small>
                </div>

                <div class="form-group">
                    <label for="posts_archive_label">{_'Posts label'}</label>
                    <input type="text" id="posts_archive_label" name="posts_archive_label"
                           value="{$options['site.posts_archive_label'] ?? 'Blog'}"
                           placeholder="Blog">
                    <small class="form-hint">{_'Human-readable label shown in breadcrumbs and sidebar widgets. Examples:'} <em>Blog</em>, <em>Journal</em>, <em>News</em>, <em>記事</em>.</small>
                </div>
            </fieldset>

            <div class="form-group">
                <label for="scripts_head">&lt;head&gt; {_'Additional Scripts'}</label>
                <textarea id="scripts_head" name="scripts_head" rows="5" placeholder="<script>...</script>" class="font-mono text-xs">{$options['scripts.head'] ?? ''}</textarea>
                <small class="form-hint">{_'Paste scripts such as Google Analytics here.'}</small>
            </div>

            <div class="form-group">
                <label for="scripts_body">&lt;body&gt; {_'Footer Scripts'}</label>
                <textarea id="scripts_body" name="scripts_body" rows="5" class="font-mono text-xs">{$options['scripts.body'] ?? ''}</textarea>
            </div>

            <div class="mt-6">
                <button type="submit" class="btn btn-primary">{_'Save Changes'}</button>
            </div>
        </form>
    </div>
</div>
{/block}

{block scripts}
<script src="/admin/assets/js/media-picker.js"></script>
<script src="/admin/assets/js/favicon-picker.js"></script>
{/block}
