{layout '../../layouts/admin-base.latte'}

{block page_title}Site Settings{/block}

{block content}
<div class="page-header">
    <div>
        <h1>Site Settings</h1>
        <p class="subtitle">General site configuration.</p>
    </div>
</div>

<nav class="tabs">
    <a href="/admin/settings/general" class="is-active">General</a>
    <a href="/admin/settings/seo">SEO</a>
    <a href="/admin/settings/modules">Modules</a>
</nav>

<div class="card max-w-3xl">
    <div class="card-body">
        <form method="post" action="/admin/settings/general">
            <input type="hidden" name="_csrf_token" value="{$csrf_token}">

            <div class="form-group">
                <label for="site_name">Site Name</label>
                <input type="text" id="site_name" name="site_name"
                       value="{$options['site.name'] ?? ''}" required>
            </div>

            <div class="form-group">
                <label for="site_description">Site Description</label>
                <textarea id="site_description" name="site_description" rows="3">{$options['site.description'] ?? ''}</textarea>
            </div>

            <fieldset class="form-fieldset">
                <legend>Home page</legend>

                <div class="form-group">
                    <label for="home_mode">What to show at <code>/</code></label>
                    {var $homeMode = $options['site.home_mode'] ?? 'archive'}
                    <select id="home_mode" name="home_mode">
                        <option value="archive" {$homeMode === 'archive' ? 'selected' : ''}>Latest posts (archive)</option>
                        <option value="page" {$homeMode === 'page' ? 'selected' : ''}>A static page</option>
                    </select>
                    <small class="form-hint">When set to <strong>A static page</strong>, pick which page below. Themes can still differentiate the two <code>/</code> and <code>/{$options['site.posts_archive_slug'] ?? 'blog'}</code> pages via a <code>home.latte</code> template.</small>
                </div>

                <div class="form-group">
                    <label for="home_page_id">Home page (when using a static page)</label>
                    {var $homePageId = $options['site.home_page_id'] ?? ''}
                    <select id="home_page_id" name="home_page_id">
                        <option value="">— select a page —</option>
                        {foreach $pages as $p}
                            <option value="{$p['id']}" {$homePageId === $p['id'] ? 'selected' : ''}>{$p['title']}</option>
                        {/foreach}
                    </select>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>Posts archive</legend>

                <div class="form-group">
                    <label for="posts_archive_slug">Posts URL path</label>
                    <input type="text" id="posts_archive_slug" name="posts_archive_slug"
                           value="{$options['site.posts_archive_slug'] ?? 'blog'}"
                           placeholder="blog" pattern="[A-Za-z0-9_\-]+">
                    <small class="form-hint">
                        URL segment for the posts archive and single post pages, e.g.
                        <code>blog</code> → <code>/blog</code>, <code>/blog/hello-world</code>.
                        Allowed characters: letters, digits, <code>-</code>, <code>_</code>.
                        Reserved words (<code>admin</code>, <code>api</code>, <code>search</code>,
                        <code>category</code>, <code>tag</code>, <code>page</code>, <code>feed</code>)
                        are rejected silently — the slug falls back to <code>blog</code>.
                        <strong>Changing this does not create redirects from the old path.</strong>
                        If you already published posts under the old slug,
                        add redirects at <a href="/admin/redirects" class="text-brand-600 hover:underline">Redirects</a>
                        (e.g. <code>/blog/foo</code> → <code>/journal/foo</code>).
                    </small>
                </div>

                <div class="form-group">
                    <label for="posts_archive_label">Posts label</label>
                    <input type="text" id="posts_archive_label" name="posts_archive_label"
                           value="{$options['site.posts_archive_label'] ?? 'Blog'}"
                           placeholder="Blog">
                    <small class="form-hint">Human-readable label shown in breadcrumbs and sidebar widgets. Examples: <em>Blog</em>, <em>Journal</em>, <em>News</em>, <em>記事</em>.</small>
                </div>
            </fieldset>

            <div class="form-group">
                <label for="scripts_head">&lt;head&gt; Additional Scripts</label>
                <textarea id="scripts_head" name="scripts_head" rows="5" placeholder="<script>...</script>" class="font-mono text-xs">{$options['scripts.head'] ?? ''}</textarea>
                <small class="form-hint">Paste scripts such as Google Analytics here.</small>
            </div>

            <div class="form-group">
                <label for="scripts_body">&lt;body&gt; Footer Scripts</label>
                <textarea id="scripts_body" name="scripts_body" rows="5" class="font-mono text-xs">{$options['scripts.body'] ?? ''}</textarea>
            </div>

            <div class="mt-6">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
{/block}
