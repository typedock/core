{layout '../../layouts/admin-base.latte'}

{block page_title}{_'API Settings'}{/block}

{block content}
<div class="page-header">
    <div>
        <h1>{_'API Settings'}</h1>
        <p class="subtitle">{_'Issue scoped Bearer tokens for integrations that need TypeDock content or media.'}</p>
    </div>
</div>

<nav class="tabs">
    <a href="/admin/settings/general">{_'General'}</a>
    <a href="/admin/settings/seo">{_'SEO'}</a>
    <a href="/admin/settings/mail">{_'Mail'}</a>
    <a href="/admin/settings/api" class="is-active">{_'API'}</a>
    <a href="/admin/settings/modules">{_'Modules'}</a>
    <a href="/admin/settings/cache">{_'Cache'}</a>
</nav>

{if isset($new_api_key) && $new_api_key}
<div class="alert alert-success">
    <div>
        <strong>{_'New API key'}</strong>
        <div class="font-mono text-xs break-all mt-2">{$new_api_key}</div>
    </div>
</div>
{/if}

{if isset($flash_success) && $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if isset($flash_error) && $flash_error}<div class="alert alert-danger">{$flash_error}</div>{/if}

<div class="space-y-6">
    <div class="card max-w-3xl">
        <div class="card-header"><h2>{_'Availability'}</h2></div>
        <div class="card-body">
            <form method="post" action="/admin/settings/api">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <label class="switch">
                    <input type="checkbox" name="api_enabled" value="1" {$api_enabled ? 'checked' : ''} {$api_env_locked ? 'disabled' : ''}>
                    <span>{_'Enable external API routes under'} <code>/api/v1</code></span>
                </label>
                {if $api_env_locked}
                    <small class="form-hint">{_'The API is enabled by configuration, so this switch is locked on.'}</small>
                {else}
                    <small class="form-hint">{_'When disabled, every'} <code>/api/*</code> {_'route returns 404.'}</small>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">{_'Save API Setting'}</button>
                    </div>
                {/if}
            </form>
        </div>
    </div>

    <div class="card max-w-3xl">
        <div class="card-header"><h2>{_'Create API Key'}</h2></div>
        <div class="card-body">
            <form method="post" action="/admin/settings/api/keys">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <div class="form-group">
                    <label for="api-key-name">{_'Name'}</label>
                    <input type="text" id="api-key-name" name="name" placeholder="{_'Deployment sync, local script, content audit'}" required>
                </div>

                <div class="form-group">
                    <label for="expires-in-days">{_'Expires in days'}</label>
                    <input type="number" id="expires-in-days" name="expires_in_days" min="0" max="3650" value="365">
                    <small class="form-hint">{_'Use 0 for no expiry. Short-lived keys are easier to rotate safely.'}</small>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="inherit_role" value="1">
                        {_'Inherit my admin role permissions instead of fixed scopes'}
                    </label>
                </div>

                <fieldset class="form-fieldset">
                    <legend>{_'Scopes'}</legend>
                    <div class="columns columns-2">
                        {foreach $scopes as $scope => $label}
                            <label class="checkbox-label">
                                <input type="checkbox" name="scopes[]" value="{$scope}" {in_array($scope, $default_scopes, true) ? 'checked' : ''}>
                                <span><code>{$scope}</code> {$label|translate}</span>
                            </label>
                        {/foreach}
                    </div>
                </fieldset>

                <div class="mt-6">
                    <button type="submit" class="btn btn-primary">{_'Create Key'}</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2>{_'API Keys'}</h2>
            <span class="text-xs text-slate-500">{_'Plaintext keys are shown only once.'}</span>
        </div>
        <table class="data-table border-0 rounded-none shadow-none">
            <thead>
                <tr>
                    <th>{_'Name'}</th>
                    <th>{_'Prefix'}</th>
                    <th>{_'Scopes'}</th>
                    <th>{_'Last Used'}</th>
                    <th>{_'Expires'}</th>
                    <th class="text-right">{_'Actions'}</th>
                </tr>
            </thead>
            <tbody>
                {foreach $api_keys as $key}
                <tr>
                    <td class="font-medium">{$key['name']}</td>
                    <td><code>td_{$key['key_prefix']}_...</code></td>
                    <td class="text-xs text-slate-600">{$key['scope_label']|translate}</td>
                    <td class="text-xs text-slate-500">{($key['last_used_at'] ?? 'Never')|translate}</td>
                    <td class="text-xs text-slate-500">{($key['expires_at'] ?? 'Never')|translate}</td>
                    <td class="text-right">
                        <form method="post" action="/admin/settings/api/keys/revoke" class="inline" onsubmit="return confirm({_'Revoke this API key?'});">
                            <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                            <input type="hidden" name="id" value="{$key['id']}">
                            <button type="submit" class="btn btn-danger btn-sm">{_'Revoke'}</button>
                        </form>
                    </td>
                </tr>
                {else}
                <tr>
                    <td colspan="6" class="text-center text-slate-500">{_'No API keys yet.'}</td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/block}
