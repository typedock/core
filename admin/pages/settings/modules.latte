{layout '../../layouts/admin-base.latte'}

{block page_title}Modules{/block}

{block content}
<div class="page-header">
    <div>
        <h1>Modules and Plugins</h1>
        <p class="subtitle">Modules ship with Core; plugins live under <code>plugins/</code> and toggle here.</p>
    </div>
</div>

<nav class="tabs">
    <a href="/admin/settings/general">General</a>
    <a href="/admin/settings/seo">SEO</a>
    <a href="/admin/settings/mail">Mail</a>
    <a href="/admin/settings/api">API</a>
    <a href="/admin/settings/modules" class="is-active">Modules</a>
</nav>

{if isset($flash_success) && $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if isset($flash_error) && $flash_error}<div class="alert alert-danger">{$flash_error}</div>{/if}

<div class="space-y-6">
    <div class="card">
        <div class="card-header"><h2>Install plugin from zip</h2></div>
        <div class="card-body">
            <p class="form-hint" style="margin-top:0">
                Drop a zip exported from another TypeDock site or a plugin repo. The archive must contain a <code>plugin.json</code> at its root (or inside a single wrapper folder, like the <em>Download ZIP</em> button on GitHub produces).
            </p>
            <form method="post" action="/admin/settings/modules/plugins/upload" enctype="multipart/form-data">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <div class="form-group">
                    <label for="plugin_zip">Plugin archive (.zip)</label>
                    <input type="file" id="plugin_zip" name="plugin_zip" accept=".zip,application/zip" required>
                    <small class="form-hint">Plugins land disabled — flip the toggle below after install to activate.</small>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="overwrite" value="1">
                        Overwrite if a plugin with the same slug already exists
                    </label>
                </div>
                <button type="submit" class="btn btn-primary">Install</button>
            </form>
        </div>
    </div>

    {if !empty($plugin_issues)}
    <div class="card">
        <div class="card-header"><h2>Plugin load diagnostics</h2></div>
        <table class="data-table border-0 rounded-none shadow-none">
            <thead><tr><th>Plugin</th><th>Level</th><th>Message</th></tr></thead>
            <tbody>
                {foreach $plugin_issues as $issue}
                    <tr>
                        <td class="font-medium">{$issue['slug']}</td>
                        <td><span class="badge {$issue['level'] === 'error' ? 'badge-danger' : 'badge-warning'}">{$issue['level']}</span></td>
                        <td>{$issue['message']}</td>
                    </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
    {/if}

    {if !empty($modules)}
    <div class="card">
        <div class="card-header">
            <h2>Modules</h2>
            <span class="text-xs text-slate-500">Core features; status mirrors <code>.env</code>.</span>
        </div>
        <table class="data-table border-0 rounded-none shadow-none">
            <thead><tr><th>Module</th><th>Status</th></tr></thead>
            <tbody>
                {foreach $modules as $name => $enabled}
                <tr>
                    <td class="font-medium">{$name}</td>
                    <td><span class="badge {$enabled ? 'badge-success' : 'badge-muted'}">{$enabled ? 'Enabled' : 'Disabled'}</span></td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
    {/if}

    <div class="card">
        <div class="card-header">
            <h2>Plugins</h2>
            <span class="text-xs text-slate-500">Toggle to enable; takes effect on next request.</span>
        </div>
        <table class="data-table border-0 rounded-none shadow-none">
            <thead>
                <tr>
                    <th>Plugin</th>
                    <th>Source</th>
                    <th>Version</th>
                    <th>State</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {foreach $plugins as $p}
                <tr>
                    <td class="font-medium">{$p['name']} <span class="text-xs text-slate-500">({$p['slug']})</span></td>
                    <td><span class="badge badge-muted">{$p['source']}</span></td>
                    <td class="text-xs text-slate-500">{$p['version']}</td>
                    <td>
                        <span class="badge {$p['enabled'] ? 'badge-success' : 'badge-muted'}">
                            {$p['enabled'] ? 'Enabled' : 'Disabled'}
                        </span>
                        <div class="text-xs text-slate-500 mt-1">via {$p['state_source']}</div>
                    </td>
                    <td class="text-right">
                        {if $p['docs_url']}
                            <a href="{$p['docs_url']}" class="btn btn-ghost btn-sm">Docs</a>
                        {/if}
                        <form method="post" action="/admin/settings/modules/plugins/toggle" class="inline">
                            <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                            <input type="hidden" name="slug" value="{$p['slug']}">
                            <input type="hidden" name="enabled" value="{$p['enabled'] ? '' : '1'}">
                            <button type="submit" class="btn btn-secondary btn-sm">
                                {$p['enabled'] ? 'Disable' : 'Enable'}
                            </button>
                        </form>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/block}
