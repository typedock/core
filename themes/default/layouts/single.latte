{layout 'base.latte'}

{block title}{$page->title} - {$site->name}{/block}
{block description}{$page->excerpt ?? ''}{/block}

{block content}
<div class="container">
    <div class="content-area">
        {include '../partials/breadcrumb.latte'}
        <article class="post">
            <header class="post-header">
                <h1 class="post-title">{$page->title}</h1>
                <div class="post-meta">
                    {if $page->author->name}
                        <span class="author">
                            {if $page->author->slug}<a href="/author/{$page->author->slug}">{$page->author->name}</a>{else}{$page->author->name}{/if}
                        </span>
                    {/if}
                    {if $page->publishedAt}
                        <time datetime="{$page->publishedAt}">{$page->publishedAt|date:'F j, Y'}</time>
                    {/if}
                </div>
            </header>

            <div class="post-body">
                {$page->renderedBody|noescape}
            </div>

            <footer class="post-footer">
                {=component('author_profile')|noescape}
                {=slot('after_content')|noescape}
            </footer>
        </article>
    </div>

    <aside class="sidebar">
        {=slot('sidebar')|noescape}
    </aside>
</div>
{/block}
