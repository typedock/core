{if !empty($posts)}
{var $title = isset($params['title']) ? (string) $params['title'] : 'Related Posts'}
<div class="related-posts">
    {if $title !== ''}<h3 class="related-posts-title widget-title">{$title}</h3>{/if}
    <div class="related-posts-grid">
        {foreach $posts as $post}
        <article class="related-post-card">
            {if $post->thumbnail}
                <a class="related-post-thumb" href="{$post->url}" aria-label="Read {$post->title}">
                    <img src="{$post->thumbnail}" alt="{$post->thumbnailAlt}" loading="lazy">
                </a>
            {/if}
            <h4><a href="{$post->url}">{$post->title}</a></h4>
            {if $post->excerpt}<p>{$post->excerpt}</p>{/if}
        </article>
        {/foreach}
    </div>
</div>
{/if}
