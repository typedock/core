{if !empty($posts)}
<div class="widget widget-latest-posts">
    <h3 class="widget-title">Latest Posts</h3>
    <ul class="post-list">
        {foreach $posts as $post}
        <li class="post-list-item">
            <a href="{config('app.url')}/blog/{$post['slug']}">{$post['title']}</a>
            {if $post['published_at']}
                <time datetime="{$post['published_at']}">{$post['published_at']|date:'Y/m/d'}</time>
            {/if}
        </li>
        {/foreach}
    </ul>
</div>
{/if}
