{if !empty($posts)}
{var $title = isset($params['title']) ? (string) $params['title'] : 'Latest Posts'}
<div class="widget widget-latest-posts">
    {if $title !== ''}<h3 class="widget-title">{$title}</h3>{/if}
    <ul class="post-list">
        {foreach $posts as $post}
        <li class="post-list-item">
            {if $post->thumbnail}
                <a class="post-list-item-thumb" href="{$post->url}" aria-label="Read {$post->title}">
                    <img src="{$post->thumbnail}" alt="{$post->thumbnailAlt}" loading="lazy">
                </a>
            {/if}
            <span class="post-list-item-body">
                <a href="{$post->url}">{$post->title}</a>
                {if $post->publishedAt}
                    <time datetime="{$post->publishedAt}">{$post->publishedAt|date:'Y/m/d'}</time>
                {/if}
            </span>
        </li>
        {/foreach}
    </ul>
</div>
{/if}
