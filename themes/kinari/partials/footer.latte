<div class="site-footer-inner">
    <div class="footer-widgets">
        <div class="footer-column">
            <h3 class="footer-column-title">Recent</h3>
            {=slot('footer_primary')|noescape}
        </div>
        <div class="footer-column">
            <h3 class="footer-column-title">Categories</h3>
            {=slot('footer_secondary')|noescape}
        </div>
        <div class="footer-column">
            <h3 class="footer-column-title">Tags</h3>
            {=slot('footer_tertiary')|noescape}
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-branding">
            <a href="/" class="footer-site-title">{$site->name}</a>
            <p class="copyright">&copy; {date('Y')} {$site->name}. All rights reserved.</p>
        </div>
        <nav class="footer-nav" aria-label="Secondary">
            <ul class="menu-list">
                {foreach $site->menu('footer') as $item}
                    <li class="menu-item"><a href="{$item->url}">{$item->label}</a></li>
                {/foreach}
            </ul>
        </nav>
    </div>
</div>
