{layout 'base.latte'}

{block title}
    {if isset($category)}{$category['name']} - {$site->name}
    {elseif isset($tag)}{$tag['name']} - {$site->name}
    {else}{$site->postsArchiveLabel} - {$site->name}
    {/if}
{/block}

{block content}
<div class="container post-layout">
    <div class="archive">
        {include '../partials/breadcrumb.latte'}
        <header class="archive-header">
            {if isset($category)}
                <h1>{$category['name']}</h1>
                {if $category['description'] ?? ''}<p>{$category['description']}</p>{/if}
            {elseif isset($tag)}
                <h1>#{$tag['name']}</h1>
                <p>Stories filed under this tag.</p>
            {else}
                <h1>{$site->postsArchiveLabel}</h1>
                {if $site->option('site.description')}<p>{$site->option('site.description')}</p>{/if}
            {/if}
        </header>

        {if empty($posts)}
            <p class="no-posts">No posts to display.</p>
        {else}
            <div class="post-grid">
                {foreach $posts as $post}
                <article class="post-card">
                    {if $post->thumbnail}
                        <a class="post-card-thumb" href="{$post->url}" aria-label="Read {$post->title}">
                            <img src="{$post->thumbnail}" alt="{$post->thumbnailAlt}" loading="lazy">
                        </a>
                    {/if}
                    <h2 class="post-card-title">
                        <a href="{$post->url}">{$post->title}</a>
                    </h2>
                    <div class="post-card-meta">
                        {if $post->publishedAt}
                            <time datetime="{$post->publishedAt}">{$post->publishedAt|date:'M j, Y'}</time>
                        {/if}
                        {if $post->author->name}
                            <span class="entry-meta-sep" aria-hidden="true">·</span>
                            <span>{$post->author->name}</span>
                        {/if}
                    </div>
                    {if $post->excerpt}
                        <p class="post-card-excerpt">{$post->excerpt}</p>
                    {/if}
                    <a href="{$post->url}" class="post-card-more">Read →</a>
                </article>
                {/foreach}
            </div>

            {include '../partials/pagination.latte'}
        {/if}
    </div>

    <aside class="sidebar" aria-label="Sidebar">
        {=slot('sidebar')|noescape}
    </aside>
</div>
{/block}
