{layout 'base.latte'}

{block title}{$author['display_name']} - {$site->name}{/block}
{block description}{$author['bio'] ?? ''}{/block}

{block content}
<div class="container post-layout">
    <div class="archive">
        <header class="archive-header author-archive-header">
            <p class="archive-kicker">Author</p>
            {include '../components/author-profile.latte'}
        </header>

        {if empty($posts)}
            <p class="no-posts">No posts to display.</p>
        {else}
            <div class="post-grid">
                {foreach $posts as $post}
                <article class="post-card">
                    {if $post->thumbnail}
                        <a class="post-card-thumb" href="{$post->url}" aria-label="Read {$post->title}">
                            <img src="{$post->thumbnail}" alt="{$post->thumbnailAlt}" loading="lazy">
                        </a>
                    {/if}
                    <h2 class="post-card-title">
                        <a href="{$post->url}">{$post->title}</a>
                    </h2>
                    <div class="post-card-meta">
                        {if $post->publishedAt}
                            <time datetime="{$post->publishedAt}">{$post->publishedAt|date:'M j, Y'}</time>
                        {/if}
                    </div>
                    {if $post->excerpt}
                        <p class="post-card-excerpt">{$post->excerpt}</p>
                    {/if}
                    <a href="{$post->url}" class="post-card-more">Read</a>
                </article>
                {/foreach}
            </div>

            {include '../partials/pagination.latte'}
        {/if}
    </div>

    <aside class="sidebar" aria-label="Sidebar">
        {=slot('sidebar')|noescape}
    </aside>
</div>
{/block}
