# TypeDock public/.htaccess — authoritative when DocumentRoot = public/.

Options -Indexes -ExecCGI

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect to HTTPS (uncomment in production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Allow direct access to actual files and directories.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Belt and braces: block dotfiles and backup/config files if they ever appear here.
<FilesMatch "^(\.env.*|\..*|composer\.(json|lock)|.*\.(sql|sh|log|ini|bak|swp))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
