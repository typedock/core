{
  "name": "typedock-admin-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Build pipeline for TypeDock admin CSS (Tailwind 4) and the Tiptap editor bundle. End users receive the compiled files; only core developers run this.",
  "scripts": {
    "build:css": "tailwindcss -i resources/admin/admin.css -o public/admin/assets/css/admin.css --minify",
    "watch:css": "tailwindcss -i resources/admin/admin.css -o public/admin/assets/css/admin.css --watch",
    "build:editor": "NODE_ENV=production node esbuild.config.mjs",
    "watch:editor": "node esbuild.config.mjs --watch",
    "test:js": "vitest run --environment jsdom",
    "build": "npm run build:css && npm run build:editor",
    "watch": "npm run watch:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-character-count": "^3.22.5",
    "@tiptap/extension-drag-handle": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.6.6",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-typography": "^3.22.5",
    "@tiptap/pm": "^3.6.6",
    "@tiptap/starter-kit": "^3.22.5"
  }
}
