# VCS
.git/
.gitignore

# Dependencies (installed inside the image)
vendor/
node_modules/

# Runtime / cache data
storage/cache/
storage/logs/
storage/sessions/
storage/tmp/
storage/uploads/*
!storage/uploads/.gitkeep
storage/.installed
storage/database.sqlite

# Tests & internal docs are not needed at runtime
tests/
docs-internal/

# Local env / logs
.env
docker.env
*.log
build.log

# Editor / OS cruft
.idea/
.vscode/
.DS_Store

# Devcontainer / Docker meta (not needed inside the image itself)
.devcontainer/
