# TypeDock — environment variables for Docker Compose.
#
# Copy to docker.env and edit:
#   cp docker.env.example docker.env
#
# These are injected into the app container by docker-compose (env_file).
# For non-Docker deployments, use config.php instead.

# Application
APP_NAME=TypeDock
APP_URL=http://localhost:8080
APP_DEBUG=false
APP_LOCALE=en
APP_TIMEZONE=UTC
# Required for encrypted credentials and signed runtime secrets.
# Generate with:
#   php -r 'echo "base64:" . base64_encode(random_bytes(32)) . PHP_EOL;'
APP_KEY=
SESSION_SECRET=

# Database (mysql/pgsql/sqlite)
DB_DRIVER=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=typedock
#DB_USERNAME=root
#DB_PASSWORD=

# SQLite (only when DB_DRIVER=sqlite)
DB_SQLITE_PATH=/app/storage/database.sqlite

# Cache
LATTE_AUTO_REFRESH=true
CACHE_STATIC_HTML=false
CACHE_TTL=3600

# Auth
SESSION_LIFETIME=86400
AUTH_TWO_FACTOR=false
AUTH_HASH_ALGO=bcrypt

# Mail
MAIL_MAILER=php
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=TypeDock
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Storage
# Local upload paths and MIME allowlists are defined in config/filesystems.php.
# S3-compatible storage is configured through the official Cloud Storage plugin.

# ----------------------------------------------------------------------------
# OWASP ZAP authenticated admin scan (bin/security-scan.sh admin)
# ----------------------------------------------------------------------------
# DANGER: enabling SECURITY_SCAN_MODE makes CsrfMiddleware skip token
# verification on requests from private/loopback IPs. APP_DEBUG must also be
# true for the bypass to engage (defense in depth). Reset BOTH to false before
# deploying anywhere real. The active scan mutates content as the logged-in
# user — point it at a throwaway DB only.
#
#SECURITY_SCAN_MODE=true
#ZAP_ADMIN_USER=admin@example.test
#ZAP_ADMIN_PASS=changeme
