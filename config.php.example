<?php
/**
 * TypeDock central configuration.
 *
 * Copy this file to config.php and edit values for your environment — or let
 * the browser installer generate it for you.
 *
 * Precedence (highest first):
 *   1. Real environment variables (useful for containerized / PaaS deploys).
 *   2. Values returned from this array.
 *
 * This file is executed as PHP, so unlike a plain .env file it never leaks its
 * source even if the webserver momentarily fails to enforce access rules.
 */

declare(strict_types=1);

return [
    // --- Application ---
    'APP_NAME'       => 'TypeDock',
    'APP_URL'        => 'http://localhost',
    'APP_DEBUG'      => 'false',
    'APP_LOCALE'     => 'en',
    'APP_TIMEZONE'   => 'UTC',
    'APP_BASE_PATH'  => '',
    'API_ENABLED'    => 'false',
    'TYPEDOCK_INSTALLATION_MODE' => 'auto',
    'SELF_UPDATE_ENABLED' => 'true',
    'UPDATE_CHANNEL' => 'stable',

    // Rotate these if ever leaked. Generated by the installer as base64:<32 random bytes>.
    'APP_KEY'        => '',
    'SESSION_SECRET' => '',

    // --- Database (mysql / pgsql / sqlite / experimental libsql) ---
    'DB_DRIVER'      => 'mysql',
    'DB_HOST'        => '127.0.0.1',
    'DB_PORT'        => '3306',
    'DB_DATABASE'    => 'typedock',
    'DB_USERNAME'    => 'root',
    'DB_PASSWORD'    => '',
    'DB_CHARSET'     => 'utf8mb4',
    'DB_PREFIX'      => '',
    'DB_SQLITE_PATH' => '',

    // --- Experimental remote-only libSQL (Turso / Bunny Database) ---
    // Uses Hrana over HTTP; no native SDK, local database, or FFI is required.
    'LIBSQL_DATABASE_URL'    => '',
    'LIBSQL_AUTH_TOKEN'      => '',
    'LIBSQL_HTTP_TIMEOUT'    => '15',
    'LIBSQL_CONNECT_TIMEOUT' => '5',
    'LIBSQL_ALLOW_INSECURE'  => 'false',

    // Provider-specific aliases are accepted when the generic values are empty:
    'TURSO_DATABASE_URL'        => '',
    'TURSO_AUTH_TOKEN'          => '',
    'BUNNY_DATABASE_URL'        => '',
    'BUNNY_DATABASE_AUTH_TOKEN' => '',

    // --- SQLite tuning ---
    // balanced applies WAL + synchronous=NORMAL when the host allows it.
    // off/safe disable performance tuning but keep connection safety settings.
    // Use custom to opt into the advanced values below.
    'SQLITE_TUNING'       => 'balanced', // off / safe / balanced / custom
    'SQLITE_FOREIGN_KEYS' => 'true',
    'SQLITE_BUSY_TIMEOUT' => '5000',
    'SQLITE_WAL'          => 'true',
    'SQLITE_SYNCHRONOUS'  => 'NORMAL',
    'SQLITE_PAGE_SIZE'    => '',
    'SQLITE_CACHE_SIZE'   => '',
    'SQLITE_MMAP_SIZE'    => '',
    'SQLITE_TEMP_STORE'   => '',
    'SQLITE_LOG_WARNINGS' => 'true',

    // --- Cache ---
    // Keep Latte auto-refresh enabled so replacing theme files on disk does not
    // leave stale compiled templates behind. Set false only for tightly
    // controlled deployments that clear cache during release.
    'LATTE_AUTO_REFRESH' => 'true',

    // Public (CDN) cache headers. Normally managed from Settings -> Cache in
    // the admin; setting CACHE_PUBLIC_HEADERS to 'true' here forces the
    // feature on and locks the admin switch. The TTLs below are only the
    // defaults for a site that has never saved that form.
    //   CACHE_EDGE_TTL    -> s-maxage (how long a CDN may serve the page)
    //   CACHE_BROWSER_TTL -> max-age  (keep at 0 so edits appear after a purge)
    'CACHE_PUBLIC_HEADERS'         => 'false',
    'CACHE_EDGE_TTL'               => '600',
    'CACHE_BROWSER_TTL'            => '0',
    'CACHE_STALE_WHILE_REVALIDATE' => '86400',

    // --- Auth ---
    'SESSION_LIFETIME' => '86400',
    // Cookie names. Both start with `typedock_` so a CDN can bypass the cache
    // for signed-in visitors with a single rule.
    //   SESSION_NAME     -> PHP session (CSRF tokens, flash messages)
    //   AUTH_COOKIE_NAME -> admin login session
    'SESSION_NAME'     => 'typedock_session',
    'AUTH_COOKIE_NAME' => 'typedock_auth',
    'AUTH_TWO_FACTOR'  => 'false',
    'AUTH_HASH_ALGO'   => 'bcrypt',

    // --- Mail ---
    'MAIL_MAILER'       => 'php',
    'MAIL_FROM_ADDRESS' => 'noreply@example.com',
    'MAIL_FROM_NAME'    => 'TypeDock',
    'MAIL_HOST'         => '',
    'MAIL_PORT'         => '587',
    'MAIL_USERNAME'     => '',
    'MAIL_PASSWORD'     => '',
    'MAIL_ENCRYPTION'   => 'tls',

    // --- Storage ---
    // Local upload paths and MIME allowlists are defined in config/filesystems.php.
    // S3-compatible storage is configured through the official Cloud Storage plugin.

];
