<?php
/**
 * TypeDock central configuration.
 *
 * Copy this file to config.php and edit values for your environment — or let
 * the browser installer generate it for you.
 *
 * Precedence (highest first):
 *   1. Real environment variables (useful for containerized / PaaS deploys).
 *   2. Values returned from this array.
 *
 * This file is executed as PHP, so unlike a plain .env file it never leaks its
 * source even if the webserver momentarily fails to enforce access rules.
 */

declare(strict_types=1);

return [
    // --- Application ---
    'APP_NAME'       => 'TypeDock',
    'APP_URL'        => 'http://localhost',
    'APP_DEBUG'      => 'false',
    'APP_LOCALE'     => 'en',
    'APP_TIMEZONE'   => 'UTC',
    'APP_BASE_PATH'  => '',
    'API_ENABLED'    => 'false',
    'TYPEDOCK_INSTALLATION_MODE' => 'auto',
    'SELF_UPDATE_ENABLED' => 'true',
    'UPDATE_CHANNEL' => 'stable',

    // Rotate these if ever leaked. Generated by the installer as base64:<32 random bytes>.
    'APP_KEY'        => '',
    'SESSION_SECRET' => '',

    // --- Database (mysql / pgsql / sqlite) ---
    'DB_DRIVER'      => 'mysql',
    'DB_HOST'        => '127.0.0.1',
    'DB_PORT'        => '3306',
    'DB_DATABASE'    => 'typedock',
    'DB_USERNAME'    => 'root',
    'DB_PASSWORD'    => '',
    'DB_CHARSET'     => 'utf8mb4',
    'DB_PREFIX'      => '',
    'DB_SQLITE_PATH' => '',

    // --- Cache ---
    // Keep Latte auto-refresh enabled so replacing theme files on disk does not
    // leave stale compiled templates behind. Set false only for tightly
    // controlled deployments that clear cache during release.
    'LATTE_AUTO_REFRESH' => 'true',
    'CACHE_STATIC_HTML' => 'false',
    'CACHE_TTL'         => '3600',

    // --- Auth ---
    'SESSION_LIFETIME' => '86400',
    'AUTH_TWO_FACTOR'  => 'false',
    'AUTH_HASH_ALGO'   => 'bcrypt',

    // --- Mail ---
    'MAIL_MAILER'       => 'php',
    'MAIL_FROM_ADDRESS' => 'noreply@example.com',
    'MAIL_FROM_NAME'    => 'TypeDock',
    'MAIL_HOST'         => '',
    'MAIL_PORT'         => '587',
    'MAIL_USERNAME'     => '',
    'MAIL_PASSWORD'     => '',
    'MAIL_ENCRYPTION'   => 'tls',

    // --- Storage ---
    // Local upload paths and MIME allowlists are defined in config/filesystems.php.
    // S3-compatible storage is configured through the official Cloud Storage plugin.

];
