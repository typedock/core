# Application
APP_NAME=TypeDock
APP_URL=http://192.168.50.241:8080
APP_DEBUG=true
APP_LOCALE=ja
APP_TIMEZONE=Asia/Tokyo

# Database (mysql/pgsql/sqlite)
DB_DRIVER=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=typedock
#DB_USERNAME=root
#DB_PASSWORD=

# SQLite (only when DB_DRIVER=sqlite)
DB_SQLITE_PATH=/app/storage/database.sqlite

# Cache
CACHE_STATIC_HTML=false
CACHE_TTL=3600

# Auth
SESSION_LIFETIME=86400
AUTH_TWO_FACTOR=false
AUTH_HASH_ALGO=bcrypt

# Mail
MAIL_MAILER=php
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Storage (local/s3)
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=

# Modules (true/false)
MODULE_COLLECTION=false
MODULE_REDIRECT=false
MODULE_MAIL=false
MODULE_ANTISPAM=false
MODULE_BACKUP=false
MODULE_MULTILANG=false

# Plugins (true/false)
PLUGIN_FORM=false
PLUGIN_SOCIAL=false
PLUGIN_ADVANCED_BLOCKS=false
PLUGIN_IMAGE_OPTIMIZER=false
