{
    "slug": "source-github-docs",
    "name": "GitHub Docs Source Adapter",
    "description": "Adds a GitHub Markdown docs directory as an External Source adapter.",
    "version": "1.0.0",
    "min_core_version": "0.1.0",
    "default_enabled": true,
    "main_class": "TypeDock\\Plugin\\SourceGitHubDocs\\SourceGitHubDocsPlugin",
    "provides": ["external-source-adapter:github_docs"],
    "autoload": {
        "psr-4": {
            "TypeDock\\Plugin\\SourceGitHubDocs\\": "src/"
        }
    }
}
