{layout $plugin_ui_layout}

{block page_title}Redirects{/block}

{block content}
<div class="page-header">
    <div>
        <h1>Redirects</h1>
        <p class="text-slate-500">Send old URLs to new destinations with a 301, 302, 307, or 308 status.</p>
    </div>
</div>

<form method="post" action="{$admin_url()}" class="card">
    <input type="hidden" name="_csrf_token" value="{$csrf_token}">

    <div class="form-group">
        <label for="source_path">Source path</label>
        <input id="source_path" type="text" name="source_path" placeholder="/old-path or ~^/old/(.*)$" required>
        <p class="form-hint">
            Use a plain path for exact matches, for example <code>/old-path</code>.
            Prefix the source with <code>~</code> to enable regular expression matching,
            for example <code>~^/old/(.*)$</code>. A site may have at most
            100 regular-expression rules; use exact rules for large redirect maps.
        </p>
    </div>

    <div class="form-group">
        <label for="target_url">Target URL</label>
        <input id="target_url" type="text" name="target_url" placeholder="/new-path or https://example.com/$1" required>
        <p class="form-hint">
            Absolute <code>http://</code> and <code>https://</code> destinations are allowed;
            verify imported files before sending visitors off-site.
            Regex targets can reuse capture groups with <code>$1</code>, <code>$2</code>, and so on.
            Example: <code>~^/old/(.*)$</code> → <code>/new/$1</code>.
        </p>
    </div>

    <div class="form-group">
        <label for="status_code">Status code</label>
        <select id="status_code" name="status_code">
            <option value="301">301 Permanent</option>
            <option value="302">302 Temporary</option>
            <option value="307">307 Temporary</option>
            <option value="308">308 Permanent</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
</form>

<form method="post" action="{$admin_url('import')}" class="card" enctype="multipart/form-data">
    <input type="hidden" name="_csrf_token" value="{$csrf_token}">

    <h2>Import from a file</h2>
    <p class="text-slate-500">
        Load many rules at once. The <code>redirects-….csv</code> file that
        Tools &rarr; Import produces after a site migration can be uploaded here unchanged.
    </p>

    <div class="form-group">
        <label for="redirect_file">CSV or JSON file</label>
        <input id="redirect_file" type="file" name="redirect_file" accept=".csv,.json" required>
        <p class="form-hint">
            CSV columns are <code>from</code>, <code>to</code> and an optional <code>status</code>;
            a file with no header row is read in that order.
            JSON is an array of <code>{l}"from": "/old", "to": "/new", "status": 301{r}</code> objects.
            Files are limited to 2 MB and 5,000 rules.
            A rule whose source already exists is updated rather than duplicated,
            so the same file can safely be uploaded twice.
        </p>
    </div>

    <button type="submit" class="btn btn-primary">Import</button>
</form>

{if empty($redirects)}
    <div class="card">
        <h2>No redirects configured</h2>
        <p class="text-slate-500">Add a rule above to redirect an old URL to a new destination.</p>
    </div>
{else}
<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Source URL</th>
                <th>Target URL</th>
                <th>Code</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            {foreach $redirects as $redirect}
            <tr>
                <td><code>{$redirect['source_path']}</code></td>
                <td><code>{$redirect['target_url']}</code></td>
                <td>{$redirect['status_code']}</td>
                <td class="text-right">
                    <form method="post" action="{$admin_url($redirect['id'] . '/delete')}" class="inline">
                        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this redirect?')">Delete</button>
                    </form>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>
{/if}
{/block}
